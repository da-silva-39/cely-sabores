<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!--
      Ambiente de desenvolvimento (NÃO usar em produção).
      O banco cely_sabores é criado/gerido pelo script em schema.sql (raiz).
      Não guarde credenciais reais aqui fora de ambientes locais.
    -->
    <add name="CelySabores"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=cely_sabores;Integrated Security=True;Encrypt=False;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>