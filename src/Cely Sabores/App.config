<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!--
      Ambiente de desenvolvimento (NÃO usar em produção).
      Ajuste o valor conforme o SGBD SQL Server da sua máquina.
      Exemplos de Data Source:
        local:            Server=localhost;Database=CelySabores;Integrated Security=True;
        instância nomeada: Server=localhost\SQLEXPRESS;Database=CelySabores;Integrated Security=True;
        com usuário/senha: Server=localhost;Database=CelySabores;User Id=seuUser;Password=suaSenha;
    -->
    <add name="CelySabores"
         connectionString="Server=localhost;Database=CelySabores;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>